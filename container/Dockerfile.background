FROM node:22-bookworm-slim AS node-runtime

FROM python:3.12-slim-bookworm

ARG CODEX_NPM_PACKAGE=@openai/codex@latest
ARG CODEX_BUILD_VERSION
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_EXTRA_INDEX_URL
ARG PIP_TRUSTED_HOST

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/JoyAI-VL-Interaction-main/services/background-agent \
    HOME=/tmp \
    CODEX_HOME=/tmp/codex-home

WORKDIR /workspace/JoyAI-VL-Interaction-main/services/background-agent

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates git gosu tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY requirements.background.txt /tmp/requirements.txt
RUN python -m pip install --prefer-binary --retries 10 -r /tmp/requirements.txt \
    && test -n "$CODEX_BUILD_VERSION" \
    && npm install -g "$CODEX_NPM_PACKAGE" \
    && rm -rf /root/.npm \
    && groupadd --non-unique --gid 1000 joybg \
    && useradd --non-unique --uid 1000 --gid joybg --home-dir /tmp --shell /usr/sbin/nologin joybg

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
