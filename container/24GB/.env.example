COMPOSE_PROJECT_NAME=joyai-24gb
VLLM_IMAGE=vllm/vllm-openai:v0.22.0
CODE_ROOT=..
MODEL_ROOT=../models
CODEX_HOME_HOST=../services/background-agent/codex-home
BACKGROUND_WORKSPACE_HOST=../agent-workspace
MAIN_MODEL_ROOT=/path/to/joyai-vl-interaction
MAIN_MODEL_PATH=/tmp/main-model-root/int4_awq_g32
SERVED_MODEL_NAME=joyai-vl-interaction
MAX_MODEL_LEN=81920
MAIN_GPU_MEMORY_UTILIZATION=0.95
MAIN_GPU=0
SUMMARY_GPU=1
ASR_GPU=2
TTS_GPU=3
SUMMARY_MAX_MODEL_LEN=8192
SUMMARY_GPU_MEMORY_UTILIZATION=0.95
ASR_GPU_MEMORY_UTILIZATION=0.40
TTS_GPU_MEMORY_UTILIZATION=0.60
CHUNK=100
COMPRESS_EVERY_N_CHUNKS=5
MID_TERM_MAX_TOKENS=4000
MID_TERM_TARGET_TOKEN_COUNT=3000
LONG_TERM_MAX_TOKENS=4000
LONG_TERM_TARGET_TOKEN_COUNT=2000
LONG_TERM_MEMORY_WINDOW=5
MAIN_MAX_TOKENS=256
LIVE_VLM_PROCESS_INTERVAL=1.0
LIVE_VLM_FRAMES_PER_BATCH=1
