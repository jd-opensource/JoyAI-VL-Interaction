ARG VLLM_IMAGE=vllm/vllm-openai:v0.22.0
FROM ${VLLM_IMAGE}

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_EXTRA_INDEX_URL
ARG PIP_TRUSTED_HOST

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/JoyAI-VL-Interaction-main/services/asr

WORKDIR /workspace/JoyAI-VL-Interaction-main

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.asr-model.txt /tmp/requirements.txt
RUN python3 -m pip install --prefer-binary --retries 10 -r /tmp/requirements.txt

ENTRYPOINT []
CMD ["/bin/bash"]
