# Copy this file to livekit.env, then replace every CHANGE_ME value.
# Never commit livekit.env.
WEBUI_HOST=127.0.0.1
WEBUI_PORT=7099
LIVEKIT_SIGNAL_PORT=8298
LIVEKIT_UDP_PORT=7299
LIVEKIT_TCP_PORT=7299
LIVEKIT_RTC_IP=CHANGE_ME_PRIVATE_IP
LIVEKIT_NODE_IP=CHANGE_ME_PUBLIC_IP
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_API_KEY=CHANGE_ME_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_RANDOM_SECRET
VIDEO_UPLOAD_ROOT=/tmp/joyvl-video-uploads
VIDEO_UPLOAD_MAX_BYTES=10737418240
